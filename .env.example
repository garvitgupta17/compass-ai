# Compass AI Environment Variables Example
# Copy this file to .env and fill in your API key(s)

# LLM API Key (Supported options: Gemini API Key or OpenAI API Key)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# App Configuration
DEFAULT_LLM_PROVIDER=gemini  # gemini or openai
